# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# Required. https://aistudio.google.com/apikey
# The free tier allows 20 requests per day per model; enable billing for real use.
GEMINI_API_KEY=

# Optional. Pins the first model tried; the fallback chain handles the rest.
# GEMINI_MODEL=gemini-3.5-flash

# Canonical URLs, the sitemap and the OG image derive from this. Read at BUILD
# time, not runtime, so it must be set before the build runs.
#
# Safe to leave blank or omit: it falls back to Vercel's own URL if present,
# then to http://localhost:3100. A bare domain works too — "trove.app" is
# upgraded to "https://trove.app".
NEXT_PUBLIC_SITE_URL=

# Required to connect integrations. Encrypts third-party credentials (GitHub
# tokens, Slack webhooks) before they are stored. Without it Trove refuses to
# save them rather than writing plaintext.
#   openssl rand -base64 32
#
# CAIRN_SECRET is still read as a fallback, so a deployment predating the
# rename keeps working until this one is set.
TROVE_SECRET=

# Database. Leave both blank for local development — it falls back to a SQLite
# file under .data/ and needs no setup.
#
# Set both to deploy anywhere with a read-only filesystem (Vercel, Netlify,
# Workers). Create a database free at https://turso.tech — no card required.
#
#   turso db create trove
#   turso db show trove --url
#   turso db tokens create trove
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Only for a self-hosted container: where the local SQLite file lives. Ignored
# when TURSO_DATABASE_URL is set. Mount a volume here or data is lost.
# TROVE_DATA_DIR=/data

# Optional. Only used by the integrations page to report live auth state.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------

# Email confirmation. Both must be set before verification is ENFORCED — with
# no mailer there would be no way to confirm an address, so new accounts are
# marked verified on creation and a warning is logged instead of bricking the
# app. Set these to turn confirmation on.
#
# https://resend.com/api-keys — the from-address must be on a domain you have
# verified with Resend. Their sandbox sender only delivers to the account
# owner, which looks exactly like "verification is broken" to everyone else.
RESEND_API_KEY=
MAIL_FROM=

# Google sign-in. The button stays disabled until both are set, because a
# sign-in option that fails on click is worse than one that is not offered.
#
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth
# client ID -> Web application, then add this exact authorised redirect URI:
#
#   <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
#
# e.g. http://localhost:3100/api/auth/google/callback for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Escape hatch. Set to 1 to run in production on storage that does not survive
# a restart — a throwaway demo or preview, where losing every account on each
# instance recycle is the intended behaviour rather than a bug. Without it the
# app refuses to serve on ephemeral storage, because that failure is silent and
# looks exactly like "refreshing logs me out and deletes my data".
TROVE_ALLOW_EPHEMERAL=

# ---------------------------------------------------------------------------
# Model fallback
# ---------------------------------------------------------------------------

# Trove tries Gemini first. When Gemini is out of quota, rate limited, or
# refusing the key, it moves down this list instead of failing — which is the
# difference between "slow today" and "the whole product stopped".
#
# Both are optional and both are off until a key is present, so the chain
# collapses to Gemini alone by default. The switch is invisible to the user and
# logged for you, because a bill from a provider nobody knew was in use is a
# worse surprise than a slow request.
#
# One thing does not carry over: web search is Gemini's tool. Research answers
# from a fallback provider come back without sources rather than with invented
# ones.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Defaults to nvidia/nemotron-3.5-lightning:free, which costs
# nothing — so the fallback works on a key with no balance. Set a paid model
# here if you would rather trade money for quality.
OPENROUTER_MODEL=

# https://console.x.ai
XAI_API_KEY=
# Optional. Defaults to grok-2-latest.
XAI_MODEL=
