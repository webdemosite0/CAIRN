# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# Required. https://aistudio.google.com/apikey
# The free tier allows 20 requests per day per model; enable billing for real use.
GEMINI_API_KEY=

# Optional. Pins the first model tried; the fallback chain handles the rest.
# GEMINI_MODEL=gemini-3.5-flash

# Canonical URLs, the sitemap and the OG image derive from this. Read at BUILD
# time, not runtime, so it must be set before the build runs.
#
# Safe to leave blank or omit: it falls back to Vercel's own URL if present,
# then to http://localhost:3100. A bare domain works too — "cairn.app" is
# upgraded to "https://cairn.app".
NEXT_PUBLIC_SITE_URL=

# Optional. Only used by the integrations page to report live auth state.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
